DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/tecnoleague_entrega?schema=public"
PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# Solo desarrollo local. Sustituir por un secreto aleatorio de 32+ caracteres.
JWT_SECRET=tecnoleague-local-jwt-secret-change-before-deploy-32chars
# Debe coincidir con front/.env; es un secreto servidor-servidor.
AUTH_BRIDGE_SECRET=tecnoleague-local-astro-bridge-change-before-deploy
# Opcional: crear administrador mediante npm run db:seed.
# No cambia el rol ni la contraseña de cuentas existentes.
 ADMIN_EMAIL=admin@tecnoleague.test
 ADMIN_PASSWORD=admin_tecnoLeague
ADMIN_NAME=Administrador TecnoLeague
